---
import BaseLayout from './BaseLayout.astro';
import { events } from '../data/events';

interface Props {
  frontmatter: {
    title: string;
    event: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
const { title, event, description } = frontmatter;

const eventData = events[event] ?? null;
const resolvedMainVisual = eventData?.mainVisual;
const resolvedOgImage = eventData?.cover;
---
<BaseLayout
  title={title}
  description={description}
  ogImage={resolvedOgImage}
  layoutId="event"
>
  <article class="page container">
    <header class="page-header">
      {resolvedMainVisual && (
        <img src={resolvedMainVisual} alt={eventData?.title ?? title} class="main-visual" />
      )}
      <h1 class="page-title">{eventData?.title ?? title}</h1>
      {eventData && (
        <ul class="navigation">
          {eventData.navi.map((item) => (
            <li>
              <a href={item.url}>{item.title}</a>
            </li>
          ))}
        </ul>
      )}
    </header>
    <div class="page-content">
      <h2>{title}</h2>
      <slot />
    </div>
  </article>
</BaseLayout>
