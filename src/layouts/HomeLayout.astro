---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---
<BaseLayout title={frontmatter.title} description={frontmatter.description} isHome={true} layoutId="home">
  <article class="page container">
    <div class="page-content">
      <slot />
    </div>
  </article>
</BaseLayout>
